# Mẫu biến môi trường: chép thành `.env` ở gốc repo rồi điền giá trị trên máy local.
# Không commit `.env`; không bao giờ đặt PIN duyệt vào file này.
YOUTUBE_API_KEY=
NCBI_EMAIL=
NCBI_API_KEY=
# Elsevier API chính thức (Scopus Search/Abstract, ScienceDirect Article Retrieval) cho chuyên gia y học.
# Bỏ trống thì xưởng dùng PubMed/PMC như hiện tại.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
