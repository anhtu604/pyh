{
  "$defs": {
    "AssetKind": {
      "enum": [
        "illustration",
        "evidence_highlight",
        "data_chart",
        "medical_diagram",
        "medical_text",
        "background",
        "texture",
        "flourish",
        "transition",
        "mascot_reaction",
        "mascot_medical_annotation"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetRecord": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "sha256"
            ]
          },
          "if": {
            "properties": {
              "kind": {
                "const": "illustration"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "license": {
                "const": "Apache-2.0"
              },
              "path": {
                "pattern": "^assets/illustrations/.+\\.png$"
              },
              "prompt": {
                "pattern": "\\S",
                "type": "string"
              },
              "rights_required": {
                "const": false
              },
              "seed": {
                "type": "integer"
              },
              "semantic": {
                "const": false
              },
              "source": {
                "const": "generated:flux2-klein-4b"
              }
            },
            "required": [
              "prompt",
              "seed"
            ]
          }
        }
      ],
      "description": "One tracked asset, its classification, and its provenance.\n\n``path`` must already be a safe POSIX-relative path with no ``..``\nsegment and no absolute root; whether it actually resolves inside a\ngiven revision is checked later by :func:`validate_asset_manifest`,\nwhich has the revision root to check it against.",
      "properties": {
        "classification_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification Reason"
        },
        "creator": {
          "pattern": "\\S",
          "title": "Creator",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "license": {
          "pattern": "\\S",
          "title": "License",
          "type": "string"
        },
        "path": {
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "revision": {
          "pattern": "^[0-9]{3}$",
          "title": "Revision",
          "type": "string"
        },
        "rights_required": {
          "default": false,
          "title": "Rights Required",
          "type": "boolean"
        },
        "seed": {
          "anyOf": [
            {
              "exclusiveMaximum": 9223372036854775808,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "semantic": {
          "title": "Semantic",
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source": {
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "storyboard_role": {
          "anyOf": [
            {
              "enum": [
                "whiteboard",
                "mascot",
                "brand",
                "chart"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storyboard Role"
        }
      },
      "required": [
        "path",
        "kind",
        "semantic",
        "source",
        "license",
        "creator",
        "revision"
      ],
      "title": "AssetRecord",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The full set of tracked assets for one revision.",
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetRecord"
      },
      "title": "Assets",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "AssetManifest",
  "type": "object"
}
