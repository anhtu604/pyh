{
  "$defs": {
    "AIClipProvenance": {
      "additionalProperties": false,
      "description": "Provider request identity and measured media properties for one clip.",
      "properties": {
        "container": {
          "const": "mp4",
          "title": "Container",
          "type": "string"
        },
        "duration_ms": {
          "enum": [
            4000,
            6000,
            8000
          ],
          "title": "Duration Ms",
          "type": "integer"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "height": {
          "const": 1920,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "const": "video/mp4",
          "title": "Mime Type",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "provider": {
          "const": "google_vertex_ai",
          "title": "Provider",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "requested_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Seed"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_fps": {
          "const": 24,
          "title": "Source Fps",
          "type": "integer"
        },
        "source_frame_count": {
          "enum": [
            96,
            144,
            192
          ],
          "title": "Source Frame Count",
          "type": "integer"
        },
        "width": {
          "const": 1080,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt",
        "generated_at",
        "request_sha256",
        "output_sha256",
        "mime_type",
        "container",
        "width",
        "height",
        "source_fps",
        "duration_ms",
        "source_frame_count"
      ],
      "title": "AIClipProvenance",
      "type": "object"
    },
    "AssetKind": {
      "enum": [
        "evidence_highlight",
        "data_chart",
        "medical_diagram",
        "medical_text",
        "background",
        "texture",
        "flourish",
        "transition",
        "mascot_reaction",
        "mascot_medical_annotation",
        "ai_clip"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetRecord": {
      "additionalProperties": false,
      "description": "One tracked asset, its classification, and its provenance.\n\n``path`` must already be a safe POSIX-relative path with no ``..``\nsegment and no absolute root; whether it actually resolves inside a\ngiven revision is checked later by :func:`validate_asset_manifest`,\nwhich has the revision root to check it against.",
      "properties": {
        "ai_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIClipProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "classification_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification Reason"
        },
        "creator": {
          "pattern": "\\S",
          "title": "Creator",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "license": {
          "pattern": "\\S",
          "title": "License",
          "type": "string"
        },
        "path": {
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9]{3}$",
          "title": "Revision",
          "type": "string"
        },
        "rights_required": {
          "default": false,
          "title": "Rights Required",
          "type": "boolean"
        },
        "semantic": {
          "title": "Semantic",
          "type": "boolean"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "storyboard_role": {
          "anyOf": [
            {
              "enum": [
                "whiteboard",
                "mascot",
                "brand",
                "chart",
                "ai_clip"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storyboard Role"
        }
      },
      "required": [
        "path",
        "kind",
        "semantic",
        "sha256",
        "source",
        "license",
        "creator",
        "revision"
      ],
      "title": "AssetRecord",
      "type": "object",
      "x-invariants": {
        "ai_clip": "kind=ai_clip requires matching ai_provenance, rights_required=true, and a decorative rationale when semantic=false; other kinds forbid ai_provenance"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The full set of tracked assets for one revision.",
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetRecord"
      },
      "title": "Assets",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "AssetManifest",
  "type": "object"
}
