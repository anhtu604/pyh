{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "text_public": {
      "title": "Text Public",
      "type": "string"
    },
    "text_technical": {
      "title": "Text Technical",
      "type": "string"
    },
    "type": {
      "enum": [
        "evidence",
        "interpretation",
        "professional_opinion"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "text_public",
    "text_technical",
    "type"
  ],
  "title": "EvidenceClaim",
  "type": "object"
}
