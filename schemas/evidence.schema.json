{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "applicability": {
      "default": "",
      "title": "Applicability",
      "type": "string"
    },
    "certainty": {
      "default": "unrated",
      "enum": [
        "high",
        "moderate",
        "low",
        "very_low",
        "unrated"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "doctor_notes": {
      "default": "",
      "title": "Doctor Notes",
      "type": "string"
    },
    "evidence_direction": {
      "default": "supporting",
      "enum": [
        "supporting",
        "conflicting",
        "inconclusive"
      ],
      "title": "Evidence Direction",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "population": {
      "default": "",
      "title": "Population",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "synthetic_test_record": {
      "default": false,
      "title": "Synthetic Test Record",
      "type": "boolean"
    },
    "text_public": {
      "title": "Text Public",
      "type": "string"
    },
    "text_technical": {
      "title": "Text Technical",
      "type": "string"
    },
    "type": {
      "enum": [
        "evidence",
        "interpretation",
        "professional_opinion"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "text_public",
    "text_technical",
    "type"
  ],
  "title": "EvidenceClaim",
  "type": "object"
}
