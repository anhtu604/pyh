{
  "$defs": {
    "ChartDatum": {
      "additionalProperties": false,
      "description": "An explicitly recorded count, never extracted or estimated by the renderer.",
      "properties": {
        "ci_high": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci High"
        },
        "ci_low": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ci Low"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "maximum": 1000000000,
          "title": "Denominator",
          "type": "integer"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "count_of_total",
          "default": "count_of_total",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "source_id",
        "label",
        "value",
        "denominator",
        "unit"
      ],
      "title": "ChartDatum",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "applicability": {
      "default": "",
      "title": "Applicability",
      "type": "string"
    },
    "certainty": {
      "default": "unrated",
      "enum": [
        "high",
        "moderate",
        "low",
        "very_low",
        "unrated"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "chart_data": {
      "items": {
        "$ref": "#/$defs/ChartDatum"
      },
      "title": "Chart Data",
      "type": "array"
    },
    "doctor_notes": {
      "default": "",
      "title": "Doctor Notes",
      "type": "string"
    },
    "evidence_direction": {
      "default": "supporting",
      "enum": [
        "supporting",
        "conflicting",
        "inconclusive"
      ],
      "title": "Evidence Direction",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "population": {
      "default": "",
      "title": "Population",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "synthetic_test_record": {
      "default": false,
      "title": "Synthetic Test Record",
      "type": "boolean"
    },
    "text_public": {
      "title": "Text Public",
      "type": "string"
    },
    "text_technical": {
      "title": "Text Technical",
      "type": "string"
    },
    "type": {
      "enum": [
        "evidence",
        "interpretation",
        "professional_opinion"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "text_public",
    "text_technical",
    "type"
  ],
  "title": "EvidenceClaim",
  "type": "object"
}
