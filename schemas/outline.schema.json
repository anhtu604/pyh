{
  "$defs": {
    "OutlineChapter": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "goal": {
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "id": {
          "pattern": "^CH\\d{2}$",
          "title": "Id",
          "type": "string"
        },
        "mood": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mood"
        },
        "target_seconds": {
          "exclusiveMinimum": 0,
          "title": "Target Seconds",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "goal",
        "target_seconds"
      ],
      "title": "OutlineChapter",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chapters": {
      "items": {
        "$ref": "#/$defs/OutlineChapter"
      },
      "maxItems": 8,
      "minItems": 4,
      "title": "Chapters",
      "type": "array"
    },
    "mood": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mood"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "chapters"
  ],
  "title": "Outline",
  "type": "object"
}
