{
  "$defs": {
    "EvidenceHighlight": {
      "properties": {
        "height": {
          "maximum": 1,
          "minimum": 0,
          "title": "Height",
          "type": "number"
        },
        "image": {
          "pattern": "\\S",
          "title": "Image",
          "type": "string"
        },
        "quote": {
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "width": {
          "maximum": 1,
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "image",
        "quote",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "EvidenceHighlight",
      "type": "object",
      "x-invariants": {
        "x_plus_width": "x + width <= 1",
        "y_plus_height": "y + height <= 1"
      }
    },
    "Scene": {
      "allOf": [
        {
          "if": {
            "properties": {
              "visual": {
                "const": "evidence_highlight"
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "evidence_highlight": {
                "$ref": "#/$defs/EvidenceHighlight"
              },
              "source_marker": {
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "source_marker",
              "evidence_highlight"
            ]
          }
        }
      ],
      "properties": {
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "duration_frames": {
          "exclusiveMinimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "evidence_highlight": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceHighlight"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "narration": {
          "title": "Narration",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "pattern": "\\S",
          "title": "Source Marker"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "visual": {
          "enum": [
            "whiteboard",
            "chart",
            "evidence_highlight",
            "ai_clip"
          ],
          "title": "Visual",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start_frame",
        "duration_frames",
        "narration",
        "visual"
      ],
      "title": "Scene",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "audio_file": {
      "title": "Audio File",
      "type": "string"
    },
    "fps": {
      "const": 30,
      "default": 30,
      "title": "Fps",
      "type": "integer"
    },
    "height": {
      "const": 1920,
      "default": 1920,
      "title": "Height",
      "type": "integer"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "width": {
      "const": 1080,
      "default": 1080,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "title",
    "audio_file"
  ],
  "title": "RenderInput",
  "type": "object"
}
