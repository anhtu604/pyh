    "Scene": {
      "allOf": [
        {
          "else": {
            "properties": {
              "source_card": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "visual": {
                "const": "source_card"
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "claim_id": {
                "pattern": "\\S",
                "type": "string"
              },
              "source_card": {
                "$ref": "#/$defs/SourceCard"
              },
              "source_marker": {
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "claim_id",
              "source_marker",
              "source_card"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "visual": {
                "const": "evidence_highlight"
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "evidence_highlight": {
                "$ref": "#/$defs/EvidenceHighlight"
              },
              "source_marker": {
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "source_marker",
              "evidence_highlight"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "anatomy": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "visual": {
                "enum": [
                  "anatomy_animation",
                  "process_animation",
                  "comparison",
                  "timelapse"
                ]
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "anatomy": {
                "$ref": "#/$defs/SceneAnatomy"
              }
            },
            "required": [
              "anatomy"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "stat_gauge": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "visual": {
                "const": "stat_gauge"
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "claim_id": {
                "pattern": "\\S",
                "type": "string"
              },
              "stat_gauge": {
                "$ref": "#/$defs/StatGauge"
              }
            },
            "required": [
              "claim_id",
              "stat_gauge"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "kinetic_term": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "visual": {
                "const": "kinetic_term"
              }
            },
