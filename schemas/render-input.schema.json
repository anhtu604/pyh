            "worksheet",
            "source_card",
            "table",
            "lab_sheet",
            "text_tree",
            "credit",
            "label",
            "scale_bar"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/R5Anchor"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text",
        "start",
        "end"
      ],
      "title": "R5TextWindow",
      "type": "object"
    },
