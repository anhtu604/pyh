          "type": "array"
        },
        "end": {
          "$ref": "#/$defs/R5Anchor"
        },
        "exception_reason": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exception Reason"
        },
        "kind": {
          "enum": [
            "question",
