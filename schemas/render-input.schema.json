        },
        "component": {
          "enum": [
            "ScaleChain",
            "ZoomChain",
            "TakeawayCard",
            "VnLabSheet",
            "ReferenceDistribution",
            "CreditCard",
            "R5LiverLeakSignature",
            "StoryShot"
