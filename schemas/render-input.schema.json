          "title": "Component",
          "type": "string"
        },
        "end": {
          "$ref": "#/$defs/R5Anchor"
        },
        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "story",
            "mechanism",
            "recap",
            "credit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "long_shot_reason": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Long Shot Reason"
        },
        "question_ids": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Question Ids",
          "type": "array"
        },
        "start": {
          "$ref": "#/$defs/R5Anchor"
        },
        "text_windows": {
          "items": {
            "$ref": "#/$defs/R5TextWindow"
          },
          "title": "Text Windows",
          "type": "array"
        },
        "tier": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tier"
        }
      },
      "required": [
        "id",
        "kind",
        "tier",
        "component",
        "asset_paths",
        "question_ids",
        "start",
        "end",
        "actions",
        "text_windows"
      ],
      "title": "R5Shot",
