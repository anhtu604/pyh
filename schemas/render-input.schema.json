{
  "$defs": {
    "AnatomyCue": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Action",
          "type": "string"
        },
        "start_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Frame"
        },
        "word": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Word",
          "type": "string"
        }
      },
      "required": [
        "word",
        "action"
      ],
      "title": "AnatomyCue",
      "type": "object"
    },
    "AssetTextLabel": {
      "additionalProperties": false,
      "description": "Baked annotation declared by its target asset; overlay text belongs in Remotion.",
      "properties": {
        "asset_path": {
          "title": "Asset Path",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "asset_path",
        "text"
      ],
      "title": "AssetTextLabel",
      "type": "object"
    },
    "CaptionWord": {
      "additionalProperties": false,
      "properties": {
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start_frame",
        "end_frame"
      ],
      "title": "CaptionWord",
      "type": "object"
    },
    "EvidenceHighlight": {
      "properties": {
        "crop_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Height"
        },
        "crop_pixel_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Pixel Height"
        },
        "crop_pixel_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Pixel Width"
        },
        "crop_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Width"
        },
        "crop_x": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop X"
        },
        "crop_y": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Y"
        },
        "height": {
          "maximum": 1,
          "minimum": 0,
          "title": "Height",
          "type": "number"
        },
        "image": {
          "pattern": "\\S",
          "title": "Image",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "quote": {
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "width": {
          "maximum": 1,
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "image",
        "quote",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "EvidenceHighlight",
      "type": "object",
      "x-invariants": {
        "x_plus_width": "x + width <= 1",
        "y_plus_height": "y + height <= 1"
      }
    },
    "KineticTerm": {
      "additionalProperties": false,
      "description": "Medical term + short definition rendered via lead-word or outline-fill.",
      "properties": {
        "definition": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Definition",
          "type": "string"
        },
        "term": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Term",
          "type": "string"
        },
        "variant": {
          "default": "lead-word-zoom-assemble",
          "enum": [
            "lead-word-zoom-assemble",
            "outline-word-fill",
            "marker-underline-title",
            "title-demote-to-label"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "title": "KineticTerm",
      "type": "object"
    },
    "MascotPose": {
      "enum": [
        "welcome",
        "explain",
        "caution",
        "point_up",
        "thinking",
        "surprised",
        "thumbs_up",
        "blank_board",
        "myth_bust"
      ],
      "title": "MascotPose",
      "type": "string"
    },
    "R5Action": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "pattern": "\\S",
          "title": "Actor",
          "type": "string"
        },
        "change": {
          "pattern": "\\S",
          "title": "Change",
          "type": "string"
        },
        "compartment": {
          "pattern": "\\S",
          "title": "Compartment",
          "type": "string"
        },
        "end": {
          "$ref": "#/$defs/R5Anchor"
        },
        "outcome": {
          "pattern": "\\S",
          "title": "Outcome",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/R5Anchor"
        }
      },
      "required": [
        "actor",
        "compartment",
        "change",
        "outcome",
        "start",
        "end"
      ],
      "title": "R5Action",
      "type": "object"
    },
    "R5Anchor": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "scene_start",
            "scene_end",
            "phrase"
          ],
          "title": "Kind",
          "type": "string"
        },
        "line_id": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Id"
        },
        "phrase": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phrase"
        }
      },
      "required": [
        "kind"
      ],
      "title": "R5Anchor",
      "type": "object"
    },
    "R5Block": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "line_ids": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Line Ids",
          "type": "array"
        },
        "professional_update": {
          "title": "Professional Update",
          "type": "boolean"
        },
        "question_ids": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Question Ids",
          "type": "array"
        },
        "takeaway_line_id": {
          "pattern": "\\S",
          "title": "Takeaway Line Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "line_ids",
        "question_ids",
        "takeaway_line_id",
        "professional_update"
      ],
      "title": "R5Block",
      "type": "object"
    },
    "R5Contract": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/R5Block"
          },
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/R5Question"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "questions",
        "blocks"
      ],
      "title": "R5Contract",
      "type": "object"
    },
    "R5Question": {
      "additionalProperties": false,
      "properties": {
        "answer_line_ids": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Answer Line Ids",
          "type": "array"
        },
        "hook_line_id": {
          "pattern": "\\S",
          "title": "Hook Line Id",
          "type": "string"
        },
        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "hook_line_id",
        "answer_line_ids"
      ],
      "title": "R5Question",
      "type": "object"
    },
    "R5RevisionAsset": {
      "additionalProperties": false,
      "description": "Verified, revision-local provenance, shared with the R5 renderer.",
      "properties": {
        "author": {
          "pattern": "\\S",
          "title": "Author",
          "type": "string"
        },
        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "license": {
          "enum": [
            "Public Domain",
            "CC0",
            "CC BY 3.0",
            "CC BY 4.0"
          ],
          "title": "License",
          "type": "string"
        },
        "license_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "License Url"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "pattern": "\\S",
          "title": "Repository",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_page": {
          "pattern": "^https://\\S+$",
          "title": "Source Page",
          "type": "string"
        },
        "title": {
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "title",
        "author",
        "repository",
        "license",
        "license_url",
        "source_page",
        "sha256"
      ],
      "title": "R5RevisionAsset",
      "type": "object"
    },
