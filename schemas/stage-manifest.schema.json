{
  "$defs": {
    "StageStatus": {
      "enum": [
        "running",
        "complete",
        "failed"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A single append-only record of one AI/tool stage run.\n\nA stage is only trustworthy once ``status`` is ``complete``: only then\ndoes it carry the ``output_hash`` and ``completed_at`` that bind the\nrecord to what the stage actually produced.",
  "properties": {
    "agent": {
      "pattern": "\\S",
      "title": "Agent",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "estimated_input_tokens": {
      "minimum": 0,
      "title": "Estimated Input Tokens",
      "type": "integer"
    },
    "estimated_output_tokens": {
      "minimum": 0,
      "title": "Estimated Output Tokens",
      "type": "integer"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "model": {
      "pattern": "\\S",
      "title": "Model",
      "type": "string"
    },
    "output_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Hash"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "pattern": "\\S",
      "title": "Stage",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/StageStatus"
    },
    "tool_version": {
      "pattern": "\\S",
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "stage",
    "status",
    "input_hash",
    "tool_version",
    "agent",
    "model",
    "started_at",
    "estimated_input_tokens",
    "estimated_output_tokens"
  ],
  "title": "StageManifest",
  "type": "object"
}
