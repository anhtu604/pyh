{
  "$defs": {
    "EvidenceHighlight": {
      "properties": {
        "crop_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Height"
        },
        "crop_pixel_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Pixel Height"
        },
        "crop_pixel_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Pixel Width"
        },
        "crop_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Width"
        },
        "crop_x": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop X"
        },
        "crop_y": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Y"
        },
        "height": {
          "maximum": 1,
          "minimum": 0,
          "title": "Height",
          "type": "number"
        },
        "image": {
          "pattern": "\\S",
          "title": "Image",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "quote": {
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "width": {
          "maximum": 1,
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "image",
        "quote",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "EvidenceHighlight",
      "type": "object",
      "x-invariants": {
        "x_plus_width": "x + width <= 1",
        "y_plus_height": "y + height <= 1"
      }
    },
    "MascotPose": {
      "enum": [
        "welcome",
        "explain",
        "caution"
      ],
      "title": "MascotPose",
      "type": "string"
    },
    "PercentRange": {
      "additionalProperties": false,
      "properties": {
        "max_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Max Percent",
          "type": "integer"
        },
        "min_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Min Percent",
          "type": "integer"
        }
      },
      "required": [
        "min_percent",
        "max_percent"
      ],
      "title": "PercentRange",
      "type": "object",
      "x-invariants": {
        "ordered": "min_percent <= max_percent"
      }
    },
    "Scene": {
      "allOf": [
        {
          "if": {
            "properties": {
              "visual": {
                "const": "evidence_highlight"
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "evidence_highlight": {
                "$ref": "#/$defs/EvidenceHighlight"
              },
              "source_marker": {
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "source_marker",
              "evidence_highlight"
            ]
          }
        }
      ],
      "properties": {
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "duration_frames": {
          "exclusiveMinimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "evidence_highlight": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceHighlight"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "narration": {
          "title": "Narration",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "script_line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script Line Id"
        },
        "source_marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "pattern": "\\S",
          "title": "Source Marker"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "visual": {
          "enum": [
            "whiteboard",
            "chart",
            "evidence_highlight",
            "ai_clip",
            "brand_outro"
          ],
          "title": "Visual",
          "type": "string"
        },
        "visual_assets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisualAssetRef"
          },
          "title": "Visual Assets",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start_frame",
        "duration_frames",
        "narration",
        "visual"
      ],
      "title": "Scene",
      "type": "object"
    },
    "VisualAssetRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "pose": {
          "anyOf": [
            {
              "$ref": "#/$defs/MascotPose"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "enum": [
            "whiteboard",
            "mascot",
            "brand"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "path",
        "role"
      ],
      "title": "VisualAssetRef",
      "type": "object"
    },
    "VisualBudgetOverride": {
      "additionalProperties": false,
      "properties": {
        "ai_clip": {
          "$ref": "#/$defs/PercentRange"
        },
        "chart_crop": {
          "$ref": "#/$defs/PercentRange"
        },
        "rationale": {
          "pattern": "\\S",
          "title": "Rationale",
          "type": "string"
        },
        "whiteboard_svg": {
          "$ref": "#/$defs/PercentRange"
        }
      },
      "required": [
        "rationale",
        "whiteboard_svg",
        "chart_crop",
        "ai_clip"
      ],
      "title": "VisualBudgetOverride",
      "type": "object",
      "x-invariants": {
        "feasible": "sum(min_percent) <= 100 <= sum(max_percent)"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "scenes": {
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "title": "Scenes",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "visual_budget_override": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisualBudgetOverride"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "visual_budget_profile": {
      "default": "legacy",
      "enum": [
        "legacy",
        "m6_5_v1"
      ],
      "title": "Visual Budget Profile",
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "title": "Storyboard",
  "type": "object"
}
