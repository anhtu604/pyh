{
  "$defs": {
    "AnatomyCue": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Action",
          "type": "string"
        },
        "start_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Frame"
        },
        "word": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Word",
          "type": "string"
        }
      },
      "required": [
        "word",
        "action"
      ],
      "title": "AnatomyCue",
      "type": "object"
    },
    "AssetTextLabel": {
      "additionalProperties": false,
      "description": "Baked annotation declared by its target asset; overlay text belongs in Remotion.",
      "properties": {
        "asset_path": {
          "title": "Asset Path",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "asset_path",
        "text"
      ],
      "title": "AssetTextLabel",
      "type": "object"
    },
    "CaptionWord": {
      "additionalProperties": false,
      "properties": {
        "end_frame": {
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start_frame",
        "end_frame"
      ],
      "title": "CaptionWord",
      "type": "object"
    },
    "EvidenceHighlight": {
      "properties": {
        "crop_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Height"
        },
        "crop_pixel_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Pixel Height"
        },
        "crop_pixel_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Pixel Width"
        },
        "crop_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Width"
        },
        "crop_x": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop X"
        },
        "crop_y": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crop Y"
        },
        "height": {
          "maximum": 1,
          "minimum": 0,
          "title": "Height",
          "type": "number"
        },
        "image": {
          "pattern": "\\S",
          "title": "Image",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "quote": {
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "width": {
          "maximum": 1,
          "minimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "image",
        "quote",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "EvidenceHighlight",
      "type": "object",
      "x-invariants": {
        "x_plus_width": "x + width <= 1",
        "y_plus_height": "y + height <= 1"
      }
    },
    "KineticTerm": {
      "additionalProperties": false,
      "description": "Medical term + short definition rendered via lead-word or outline-fill.",
      "properties": {
        "definition": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Definition",
          "type": "string"
        },
        "term": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Term",
          "type": "string"
        },
        "variant": {
          "default": "lead-word-zoom-assemble",
          "enum": [
            "lead-word-zoom-assemble",
            "outline-word-fill",
            "marker-underline-title",
            "title-demote-to-label"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "title": "KineticTerm",
      "type": "object"
    },
    "MascotPose": {
      "enum": [
        "welcome",
        "explain",
        "caution"
      ],
      "title": "MascotPose",
      "type": "string"
    },
    "PercentRange": {
      "additionalProperties": false,
      "properties": {
        "max_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Max Percent",
          "type": "integer"
        },
        "min_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Min Percent",
          "type": "integer"
        }
      },
      "required": [
        "min_percent",
        "max_percent"
      ],
      "title": "PercentRange",
      "type": "object",
      "x-invariants": {
        "ordered": "min_percent <= max_percent"
      }
    },
    "Scene": {
      "allOf": [
        {
          "else": {
            "properties": {
              "source_card": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "visual": {
                "const": "source_card"
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "claim_id": {
                "pattern": "\\S",
                "type": "string"
              },
              "source_card": {
                "$ref": "#/$defs/SourceCard"
              },
              "source_marker": {
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "claim_id",
              "source_marker",
              "source_card"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "visual": {
                "const": "evidence_highlight"
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "evidence_highlight": {
                "$ref": "#/$defs/EvidenceHighlight"
              },
              "source_marker": {
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "source_marker",
              "evidence_highlight"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "anatomy": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "visual": {
                "enum": [
                  "anatomy_animation",
                  "process_animation",
                  "comparison",
                  "timelapse"
                ]
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "anatomy": {
                "$ref": "#/$defs/SceneAnatomy"
              }
            },
            "required": [
              "anatomy"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "stat_gauge": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "visual": {
                "const": "stat_gauge"
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "claim_id": {
                "pattern": "\\S",
                "type": "string"
              },
              "stat_gauge": {
                "$ref": "#/$defs/StatGauge"
              }
            },
            "required": [
              "claim_id",
              "stat_gauge"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "kinetic_term": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "visual": {
                "const": "kinetic_term"
              }
            },
            "required": [
              "visual"
            ]
          },
          "then": {
            "properties": {
              "kinetic_term": {
                "$ref": "#/$defs/KineticTerm"
              }
            },
            "required": [
              "kinetic_term"
            ]
          }
        }
      ],
      "properties": {
        "anatomy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneAnatomy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "annotations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssetTextLabel"
          },
          "title": "Annotations",
          "type": "array"
        },
        "beats": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SceneBeat"
          },
          "title": "Beats",
          "type": "array"
        },
        "chapter_id": {
          "anyOf": [
            {
              "pattern": "^CH\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter Id"
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "duration_frames": {
          "exclusiveMinimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "entrances": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TextEntrance"
          },
          "title": "Entrances",
          "type": "array"
        },
        "evidence_highlight": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceHighlight"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explainer_layer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explainer Layer Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kinetic_term": {
          "anyOf": [
            {
              "$ref": "#/$defs/KineticTerm"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "labels": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssetTextLabel"
          },
          "title": "Labels",
          "type": "array"
        },
        "motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneMotion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "narration": {
          "title": "Narration",
          "type": "string"
        },
        "on_screen_text": {
          "anyOf": [
            {
              "maxLength": 90,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Screen Text"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "script_line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script Line Id"
        },
        "sfx": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SceneSFX"
          },
          "maxItems": 2,
          "title": "Sfx",
          "type": "array"
        },
        "source_card": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCard"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "pattern": "\\S",
          "title": "Source Marker"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "stat_gauge": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatGauge"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visual": {
          "enum": [
            "whiteboard",
            "chart",
            "evidence_highlight",
            "source_card",
            "brand_outro",
            "anatomy_animation",
            "process_animation",
            "comparison",
            "timelapse",
            "stat_gauge",
            "kinetic_term"
          ],
          "title": "Visual",
          "type": "string"
        },
        "visual_assets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisualAssetRef"
          },
          "title": "Visual Assets",
          "type": "array"
        },
        "words": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CaptionWord"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start_frame",
        "duration_frames",
        "narration",
        "visual"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SceneAnatomy": {
      "additionalProperties": false,
      "properties": {
        "cues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AnatomyCue"
          },
          "title": "Cues",
          "type": "array"
        },
        "motion": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Motion",
          "type": "string"
        },
        "severity": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        },
        "state": {
          "enum": [
            "normal",
            "diseased"
          ],
          "title": "State",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "state",
        "motion"
      ],
      "title": "SceneAnatomy",
      "type": "object"
    },
    "SceneBeat": {
      "additionalProperties": false,
      "description": "A scene-local visual change anchored to narration or elapsed seconds.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "title": "At"
        },
        "focus": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus"
        },
        "labels": {
          "default": [],
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 6,
          "title": "Labels",
          "type": "array"
        },
        "start_frame": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Frame"
        }
      },
      "required": [
        "at"
      ],
      "title": "SceneBeat",
      "type": "object"
    },
    "SceneMotion": {
      "additionalProperties": false,
      "description": "Optional shotcraft motion overlay and transition_in for a scene.",
      "properties": {
        "emphasis": {
          "anyOf": [
            {
              "enum": [
                "marker-underline-title",
                "lead-word-zoom-assemble",
                "outline-word-fill",
                "title-demote-to-label",
                "scan-bracket-sweep",
                "scanline-annotate-focus",
                "spotlight-sweep-moves"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emphasis"
        },
        "emphasis_text": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emphasis Text"
        },
        "transition_in": {
          "anyOf": [
            {
              "enum": [
                "circle-match-iris",
                "wipe-transitions",
                "crash-zoom-punch"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transition In"
        }
      },
      "title": "SceneMotion",
      "type": "object"
    },
    "SceneSFX": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "default": "start",
          "title": "At"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "volume": {
          "default": 0.2,
          "maximum": 0.4,
          "minimum": 0.15,
          "title": "Volume",
          "type": "number"
        }
      },
      "required": [
        "id"
      ],
      "title": "SceneSFX",
      "type": "object"
    },
    "SourceCard": {
      "additionalProperties": false,
      "description": "Renderer text copied exactly from the evidence ledger, never a source image.",
      "properties": {
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "interpretation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Interpretation",
          "type": "string"
        },
        "journal": {
          "title": "Journal",
          "type": "string"
        },
        "pmid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pmid"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "source_id",
        "title",
        "journal",
        "interpretation"
      ],
      "title": "SourceCard",
      "type": "object"
    },
    "StatGauge": {
      "additionalProperties": false,
      "description": "Single claim-backed number + unit + label rendered via gauge or chart-live.",
      "properties": {
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "max_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Value"
        },
        "unit": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "variant": {
          "default": "gauge-readout-moves",
          "enum": [
            "gauge-readout-moves",
            "chart-live-moves",
            "timeline-travel"
          ],
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit",
        "label"
      ],
      "title": "StatGauge",
      "type": "object"
    },
    "TextEntrance": {
      "additionalProperties": false,
      "properties": {
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start_frame"
      ],
      "title": "TextEntrance",
      "type": "object"
    },
    "VisualAssetRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "pose": {
          "anyOf": [
            {
              "$ref": "#/$defs/MascotPose"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "enum": [
            "whiteboard",
            "mascot",
            "brand",
            "chart"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "path",
        "role"
      ],
