{
  "$defs": {
    "TopicScores": {
      "additionalProperties": false,
      "properties": {
        "clarity": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Clarity",
          "type": "number"
        },
        "evidence_readiness": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Readiness",
          "type": "number"
        },
        "harm_risk": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Harm Risk",
          "type": "number"
        },
        "novelty": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Novelty",
          "type": "number"
        },
        "preventive_value": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Preventive Value",
          "type": "number"
        },
        "production_cost": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Production Cost",
          "type": "number"
        }
      },
      "title": "TopicScores",
      "type": "object"
    },
    "TopicSignal": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "query": {
          "default": "",
          "title": "Query",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "trend_metric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trend Metric"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "platform",
        "timestamp"
      ],
      "title": "TopicSignal",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "id": {
      "default": "",
      "title": "Id",
      "type": "string"
    },
    "origin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin"
    },
    "question": {
      "default": "",
      "title": "Question",
      "type": "string"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scores": {
      "$ref": "#/$defs/TopicScores"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/TopicSignal"
      },
      "title": "Signals",
      "type": "array"
    },
    "slug": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    },
    "status": {
      "default": "inbox",
      "enum": [
        "inbox",
        "selected",
        "rejected"
      ],
      "title": "Status",
      "type": "string"
    },
    "synthetic_test_record": {
      "default": false,
      "title": "Synthetic Test Record",
      "type": "boolean"
    },
    "target_audience": {
      "default": "",
      "title": "Target Audience",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "slug",
    "title"
  ],
  "title": "TopicCard",
  "type": "object"
}
